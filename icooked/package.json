{
  "name": "icooked",
  "private": true,
  "version": "0.1.0",
  "description": "ICooked - a chaotic PCBA factory survival game. You always get fired.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "desktop": "vite build && electron .",
    "desktop:smoke": "electron . --no-sandbox --smoke-test --use-gl=angle --use-angle=swiftshader --enable-unsafe-swiftshader"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "electron": "^44.4.5",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "main": "electron/main.cjs"
}
