(export (version "E")
  (design
    (source "nudge")
    (date "2026-06-21")
    (tool "Nudge dossier — hand-authored logical netlist")
    (sheet (number "1") (name "/") (tstamps "/")
      (title_block
        (title "Nudge wearable — core")
        (comment (number "1") (value "Passive footprints are KiCad-standard and import directly."))
        (comment (number "2") (value "IC pins are labeled by FUNCTION. Verify pad numbers against the symbol/footprint you pick for U1/U2/U3 before routing."))
        (comment (number "3") (value "Module U1 runs from VBAT; nRF52840 internal DC/DC. No external 3V3 LDO."))
        (comment (number "4") (value "Keep U1 antenna keep-out clear; battery/metal away from antenna face.")))))

  (components
    (comp (ref "U1") (value "MDBT50Q-1MV2") (footprint "Nudge:MDBT50Q-1MV2")
      (description "nRF52840 pre-certified module (radio+MCU)"))
    (comp (ref "U2") (value "LSM6DSV16X") (footprint "Package_LGA:LGA-14_2.5x3mm_P0.5mm")
      (description "6-axis IMU + ML core (Stage-1 watcher)"))
    (comp (ref "U3") (value "DRV2605L") (footprint "Package_SO:VSSOP-10_3x3mm_P0.5mm")
      (description "Haptic LRA driver"))
    (comp (ref "U4") (value "MCP73831") (footprint "Package_TO_SOT_SMD:SOT-23-5")
      (description "Single-cell LiPo charger"))
    (comp (ref "LRA1") (value "LRA") (footprint "Nudge:LRA_Z_8x3p2")
      (description "Linear resonant actuator (nudge)"))
    (comp (ref "BT1") (value "LiPo_150mAh") (footprint "Nudge:LiPo_503040")
      (description "LiPo cell + protection (PCM)"))
    (comp (ref "J1") (value "PogoCharge_2P") (footprint "Nudge:Pogo_2P")
      (description "Sealed magnetic charge target (VBUS, GND)"))
    (comp (ref "J2") (value "SWD_TC2030") (footprint "Nudge:TagConnect_TC2030")
      (description "SWD program/debug pads"))
    (comp (ref "SW1") (value "BTN") (footprint "Nudge:SW_Side_2x4")
      (description "User button"))
    (comp (ref "LED1") (value "CHG") (footprint "LED_SMD:LED_0402_1005Metric"))
    (comp (ref "LED2") (value "STAT") (footprint "LED_SMD:LED_0402_1005Metric"))
    (comp (ref "D2") (value "TVS") (footprint "Diode_SMD:D_SOD-323"))
    (comp (ref "R1") (value "4k7") (footprint "Resistor_SMD:R_0402_1005Metric"))
    (comp (ref "R2") (value "4k7") (footprint "Resistor_SMD:R_0402_1005Metric"))
    (comp (ref "R6") (value "5k") (footprint "Resistor_SMD:R_0402_1005Metric"))
    (comp (ref "R7") (value "1k") (footprint "Resistor_SMD:R_0402_1005Metric"))
    (comp (ref "R8") (value "1M") (footprint "Resistor_SMD:R_0402_1005Metric"))
    (comp (ref "R9") (value "1M") (footprint "Resistor_SMD:R_0402_1005Metric"))
    (comp (ref "R10") (value "330") (footprint "Resistor_SMD:R_0402_1005Metric"))
    (comp (ref "C1") (value "100n") (footprint "Capacitor_SMD:C_0402_1005Metric"))
    (comp (ref "C2") (value "1u") (footprint "Capacitor_SMD:C_0402_1005Metric"))
    (comp (ref "C3") (value "4u7") (footprint "Capacitor_SMD:C_0603_1608Metric"))
    (comp (ref "C4") (value "1u") (footprint "Capacitor_SMD:C_0402_1005Metric"))
    (comp (ref "C5") (value "4u7") (footprint "Capacitor_SMD:C_0603_1608Metric"))
    (comp (ref "C6") (value "100n") (footprint "Capacitor_SMD:C_0402_1005Metric"))
    (comp (ref "C6B") (value "100n") (footprint "Capacitor_SMD:C_0402_1005Metric"))
    (comp (ref "C7") (value "1u") (footprint "Capacitor_SMD:C_0402_1005Metric"))
    (comp (ref "C8") (value "100n") (footprint "Capacitor_SMD:C_0402_1005Metric"))
    (comp (ref "C9") (value "10u") (footprint "Capacitor_SMD:C_0805_2012Metric"))
    (comp (ref "C10") (value "1u") (footprint "Capacitor_SMD:C_0402_1005Metric")))

  (nets
