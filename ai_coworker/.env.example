# Copy to .env and fill in. Never commit .env.

BOT_NAME=Worker
# A line or two the bot should know about your business
COMPANY_CONTEXT=We build control cabinets. Part codes: CCA = circuit cards, CAS = assemblies.

# --- LLM (any OpenAI-compatible API) ---
# OpenAI: key from platform.openai.com (API billing is separate from ChatGPT Business seats)
LLM_API_KEY=
LLM_MODEL=gpt-5-mini
# LLM_BASE_URL=            # blank for OpenAI
# Claude instead: LLM_BASE_URL=https://api.anthropic.com/v1/  LLM_MODEL=claude-sonnet-5-5  (Anthropic API key)

# --- ERP ---
ERP_BACKEND=csv
ERP_CSV_DIR=sample_data
# Real Accentis (read-only SQL login):
# ERP_BACKEND=accentis_sql
# ACCENTIS_ODBC=DRIVER={ODBC Driver 18 for SQL Server};SERVER=accentis-sql;DATABASE=Accentis;UID=ai_readonly;PWD=...;TrustServerCertificate=yes
# ACCENTIS_QUERIES=accentis_queries.toml

MEMORY_DB=coworker_memory.sqlite3

# --- Chat ---
DISCORD_TOKEN=
DISCORD_DIGEST_CHANNEL_ID=
DIGEST_TIME=07:30
# One-way posting for run_digest.py:
DISCORD_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
